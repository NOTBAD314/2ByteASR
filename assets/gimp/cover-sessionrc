# Application-owned cover workspace. GIMP 3 sessionrc format.
(session-info "toplevel"
    (factory-entry "gimp-single-image-window")
    (position 80 80)
    (size 1280 820)
    (open-on-exit)
    (aux-info (left-docks-width "190") (right-docks-width "250") (maximized "no"))
    (gimp-toolbox (side left)
        (book (current-page 0)
            (dockable "gimp-tool-options" (tab-style automatic)
                (aux-info (show-button-bar "true")))))
    (gimp-dock (side right)
        (book (current-page 0)
            (dockable "gimp-layer-list" (tab-style automatic) (preview-size 32)
                (aux-info (show-button-bar "true"))))))
(hide-docks no)
(single-window-mode yes)
(tabs-position 0)
(session-info "toplevel" (factory-entry "gimp-file-open-dialog") (position 100 80) (size 880 560))
(session-info "toplevel" (factory-entry "gimp-file-save-dialog") (position 100 80) (size 880 560))
(session-info "toplevel" (factory-entry "gimp-file-export-dialog") (position 100 80) (size 880 560))
